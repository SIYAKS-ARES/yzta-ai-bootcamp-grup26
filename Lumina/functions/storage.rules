rules_version = '2';

// Firebase Storage güvenlik kuralları
service firebase.storage {
  match /b/{bucket}/o {
    
    // Kullanıcıların kendi upload klasörlerine dosya yüklemelerine izin ver
    match /uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Kullanıcıların kendi audio klasörlerinden ses dosyalarını okumalarına izin ver
    match /audio/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Sadece Cloud Functions yazabilir
    }
    
    // Diğer tüm dosyalar için erişim engelle
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
} 